<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:LordPack.Mobile.ViewModels"
             x:Class="LordPack.Mobile.Views.ChapterPickerPage"
             x:DataType="vm:ChapterPickerViewModel"
             Title="{Binding BookName}"
             BackgroundColor="#0F172A">

    <Grid RowDefinitions="Auto, *" Padding="16">

        <Label Grid.Row="0"
               Text="Select a Chapter"
               FontSize="14"
               TextColor="#94A3B8"
               Margin="0,0,0,12" />

        <CollectionView Grid.Row="1" ItemsSource="{Binding Chapters}">
            <CollectionView.ItemsLayout>
                <GridItemsLayout Orientation="Vertical" Span="5" HorizontalItemSpacing="10" VerticalItemSpacing="10" />
            </CollectionView.ItemsLayout>

            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="vm:ChapterItem">
                    <Border BackgroundColor="#1E293B"
                            StrokeShape="RoundRectangle 8"
                            StrokeThickness="0"
                            HeightRequest="52"
                            VerticalOptions="Center">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer
                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ChapterPickerViewModel}}, Path=SelectChapterCommand}"
                                CommandParameter="{Binding .}" />
                        </Border.GestureRecognizers>
                        <Label Text="{Binding Number}"
                               FontSize="18"
                               FontAttributes="Bold"
                               TextColor="White"
                               HorizontalOptions="Center"
                               VerticalOptions="Center" />
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

    </Grid>

</ContentPage>
