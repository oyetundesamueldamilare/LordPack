<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:LordPack.Mobile.ViewModels"
             xmlns:dtos="clr-namespace:LordPack.Shared.DTOs;assembly=LordPack.Shared"
             x:Class="LordPack.Mobile.Views.BiblePage"
             x:DataType="vm:BibleViewModel"
             Title="Scripture Reader"
             BackgroundColor="#0F172A">

    <Grid RowDefinitions="Auto, *">

        <!-- Chapter Header & Navigation Controls -->
        <Grid Grid.Row="0" 
              ColumnDefinitions="Auto, *, Auto, Auto" 
              ColumnSpacing="8" 
              Padding="12,12" 
              BackgroundColor="#1E293B">

            <!-- Previous Chapter Button -->
            <Button Grid.Column="0" 
                    Text="◄" 
                    Command="{Binding PreviousChapterCommand}" 
                    BackgroundColor="Transparent" 
                    TextColor="#94A3B8"
                    FontSize="16"
                    Padding="8,0"
                    VerticalOptions="Center" />

            <!-- Chapter Metadata -->
            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                <Label Text="{Binding CurrentChapter.BookName, FallbackValue='Genesis'}" 
                       FontSize="18" 
                       FontAttributes="Bold" 
                       TextColor="White" />
                <Label Text="{Binding CurrentChapter.ChapterNumber, StringFormat='Chapter {0}'}" 
                       FontSize="13" 
                       TextColor="#94A3B8" />
            </VerticalStackLayout>

            <!-- Next Chapter Button -->
            <Button Grid.Column="2" 
                    Text="►" 
                    Command="{Binding NextChapterCommand}" 
                    BackgroundColor="Transparent" 
                    TextColor="#94A3B8"
                    FontSize="16"
                    Padding="8,0"
                    VerticalOptions="Center" />

            <!-- Listen / Audio Playback Button -->
            <Button Grid.Column="3" 
                    Text="▶ Listen" 
                    Command="{Binding PlayChapterAudioCommand}" 
                    BackgroundColor="#6366F1" 
                    TextColor="White" 
                    CornerRadius="20" 
                    HeightRequest="40" 
                    Padding="12,0" />
        </Grid>

        <!-- Verses Collection -->
        <CollectionView Grid.Row="1" ItemsSource="{Binding Verses}" Margin="16">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="dtos:VerseDto">
                    <Grid ColumnDefinitions="Auto, *" ColumnSpacing="8" Padding="0,6">
                        <Label Grid.Column="0"
                               Text="{Binding VerseNumber}" 
                               FontSize="12" 
                               FontAttributes="Bold" 
                               TextColor="#6366F1" 
                               VerticalOptions="Start" />
                        <Label Grid.Column="1"
                               Text="{Binding Text}" 
                               FontSize="16" 
                               TextColor="#E2E8F0" 
                               LineBreakMode="WordWrap" />
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!-- Loading Indicator -->
        <ActivityIndicator Grid.Row="1" 
                           IsRunning="{Binding IsBusy}" 
                           IsVisible="{Binding IsBusy}" 
                           Color="#6366F1" 
                           VerticalOptions="Center" 
                           HorizontalOptions="Center" />

    </Grid>
</ContentPage>