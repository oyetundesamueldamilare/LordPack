<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:LordPack.Mobile.ViewModels"
             xmlns:dtos="clr-namespace:LordPack.Shared.DTOs;assembly=LordPack.Shared"
             x:Class="LordPack.Mobile.Views.BiblePage"
             x:DataType="vm:BibleViewModel"
             Title="Scripture Reader"
             BackgroundColor="#0F172A">

    <Grid RowDefinitions="Auto, *">

        <!-- Chapter Header & Audio Button -->
        <Grid Grid.Row="0" ColumnDefinitions="*, Auto" Padding="16,12" BackgroundColor="#1E293B">
            <VerticalStackLayout Grid.Column="0" VerticalOptions="Center">
                <Label Text="{Binding CurrentChapter.BookName, FallbackValue='Genesis'}" 
                       FontSize="20" FontAttributes="Bold" TextColor="White" />
                <Label Text="{Binding CurrentChapter.ChapterNumber, StringFormat='Chapter {0}'}" 
                       FontSize="14" TextColor="#94A3B8" />
            </VerticalStackLayout>

            <Button Grid.Column="1" 
                    Text="▶ Listen" 
                    Command="{Binding PlayChapterAudioCommand}" 
                    BackgroundColor="#6366F1" 
                    TextColor="White" 
                    CornerRadius="20" 
                    HeightRequest="40" />
        </Grid>

        <!-- Verses Collection -->
        <CollectionView Grid.Row="1" ItemsSource="{Binding Verses}" Margin="16">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="dtos:VerseDto">
                    <!-- ✅ Grid with Star (*) column forces verse text to wrap cleanly within bounds -->
                    <Grid ColumnDefinitions="Auto, *" ColumnSpacing="8" Padding="0,6">
                        <Label Grid.Column="0"
                               Text="{Binding VerseNumber}" 
                               FontSize="12" 
                               FontAttributes="Bold" 
                               TextColor="#6366F1" 
                               VerticalOptions="Start" />
                        <Label Grid.Column="1"
                               Text="{Binding Text}" 
                               FontSize="16" 
                               TextColor="#E2E8F0" 
                               LineBreakMode="WordWrap" />
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!-- Loading Indicator -->
        <ActivityIndicator Grid.Row="1" 
                           IsRunning="{Binding IsBusy}" 
                           IsVisible="{Binding IsBusy}" 
                           Color="#6366F1" 
                           VerticalOptions="Center" 
                           HorizontalOptions="Center" />

    </Grid>
</ContentPage>